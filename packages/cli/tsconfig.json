{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // bin/curvi.js runs src/main.ts on Node's built in type stripping, so
    // relative imports name their .ts files and only erasable syntax is used.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src", "vitest.config.ts"]
}
