{
  "name": "@curvi/cli",
  "version": "0.1.0",
  "private": true,
  "description": "The curvi command: make channel ready product image packs from a terminal or an AI agent.",
  "type": "module",
  "bin": {
    "curvi": "./bin/curvi.js"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@curvi/pipeline": "workspace:*",
    "@curvi/specs": "workspace:*",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
